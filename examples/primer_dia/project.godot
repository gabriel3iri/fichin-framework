; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Primer día (ejemplo de jornada)"
config/description="Juego de ejemplo del framework jornada"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameConfig="*res://addons/jornada/core/game_config.gd"
TimeManager="*res://addons/jornada/core/time_manager.gd"
SettingsManager="*res://addons/jornada/core/settings_manager.gd"
LoopManager="*res://addons/jornada/core/loop_manager.gd"
JournalManager="*res://addons/jornada/social/journal_manager.gd"
DeductionSystem="*res://addons/jornada/social/deduction_system.gd"
Toasts="*res://addons/jornada/core/toasts.gd"
GameManager="*res://addons/jornada/core/game_manager.gd"
DialogueManager="*res://addons/jornada/social/dialogue_manager.gd"
ZoneManager="*res://addons/jornada/world/zone_manager.gd"
TimedEvents="*res://addons/jornada/core/timed_events.gd"
WorkManager="*res://addons/jornada/work/work_manager.gd"
AudioManager="*res://addons/jornada/core/audio_manager.gd"
SaveManager="*res://addons/jornada/core/save_manager.gd"
WorldEffects="*res://addons/jornada/social/world_effects.gd"
WitnessManager="*res://addons/jornada/social/witness_manager.gd"
AnnoyanceSystem="*res://addons/jornada/social/annoyance_system.gd"
PrivateRooms="*res://addons/jornada/world/private_rooms.gd"
ChatterSystem="*res://addons/jornada/social/chatter_system.gd"
Identification="*res://addons/jornada/social/identification.gd"
Sightings="*res://addons/jornada/social/sightings.gd"
SearchSystem="*res://addons/jornada/social/search_system.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://addons/jornada/ui/skin/theme.tres"

